# CMhelper Environment Variables (Sprint A-1)

# Supabase Storage (Existing)
SUPABASE_URL=
SUPABASE_KEY=

# Authentication (Sprint A-1 Required)
# Fail-Fast: 아래 변수들이 누락되면 서버가 시작되지 않습니다.
JWT_SECRET_KEY=change_me_to_a_secure_random_string_in_production
CMHELPER_INVITE_CODE=CMHELPER2026
CMHELPER_OWNER_EMAIL=admin@cmhelper.com
CMHELPER_DEFAULT_COMPANY_NAME=Default Company
CMHELPER_DEFAULT_COMPANY_SLUG=default-company

# Optional Auth Settings
JWT_EXPIRE_MINUTES=120
