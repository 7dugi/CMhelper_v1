{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "project_id": { "type": "string" },
    "result": { "type": "string", "enum": ["READY", "NEED_USER_DECISION", "BLOCKED"] },
    "reason": { "type": "string" },
    "candidate": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "project_id": { "type": "string" },
            "title": { "type": "string" },
            "description": { "type": "string" },
        "source_documents": { "type": "array", "items": { "type": "string" } },
        "reason": { "type": "string" },
        "confidence": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
        "risk_level": { "type": "string", "enum": ["GREEN", "YELLOW", "RED"] },
        "requires_user_decision": { "type": "boolean" },
        "blocked_by": { "type": "array", "items": { "type": "string" } },
        "acceptance_criteria": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["project_id", "title", "description", "source_documents", "reason", "confidence", "risk_level", "requires_user_decision", "blocked_by", "acceptance_criteria"],
      "additionalProperties": false
        },
        { "type": "null" }
      ]
    }
  },
  "required": ["project_id", "result", "reason", "candidate"],
  "additionalProperties": false
}
